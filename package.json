{
  "name": "clapps",
  "private": true,
  "scripts": {
    "sync:clapps": "node scripts/sync-clapps.mjs",
    "build": "pnpm sync:clapps && pnpm -r build",
    "build:web-app": "pnpm sync:clapps && pnpm --filter @clappstore/web-app build",
    "dev": "pnpm sync:clapps && pnpm --filter @clappstore/web-app dev",
    "dev:connect": "pnpm sync:clapps && pnpm --filter @clappstore/connect dev",
    "test": "vitest",
    "lint": "tsc --noEmit",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=22"
  }
}
